root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# ssh config
[config]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated by `p10k configure`, do not reformat
[p10k.zsh]
trim_trailing_whitespace = false
insert_final_newline = false
