# ~/.ssh/config -- symlinked from this repo by install.sh
#
# Grouped by site. Within each group: personal accounts first, then the shared
# and teaching (ti_*) accounts.

# --- CSCS ----------------------------------------------------------------

Host ela
  HostName ela.cscs.ch
  User mjaehn
  IdentityFile ~/.ssh/cscs-key

Host santis* clariden* eiger*
  HostName %h.alps.cscs.ch
  User mjaehn
  IdentityFile ~/.ssh/cscs-key
  ProxyJump ela
  ForwardX11 yes
  ForwardX11Trusted yes

Host balfrin*
  HostName %h.cscs.ch
  User mjaehn
  IdentityFile ~/.ssh/cscs-key
  ProxyJump ela
  ForwardX11 yes
  ForwardX11Trusted yes

Host icontest_santis
  HostName santis.alps.cscs.ch
  User icontest
  IdentityFile ~/.ssh/icontest-key
  IdentitiesOnly yes
  ProxyJump ela
  ForwardX11 yes
  ForwardX11Trusted yes

# --- ETH IAC -------------------------------------------------------------
#
# fog and fog2 are the gateways; everything else jumps through them. They need
# no ForwardX11 of their own: ProxyJump/ProxyCommand tunnel the TCP connection,
# so X11 is negotiated end-to-end with the final host.

Host fog*
  HostName %h.ethz.ch
  User mjaehn
  IdentityFile ~/.ssh/id_ed25519_iac

Host atmos* co2* ch4* iacdipl* stratus*
  HostName %h.ethz.ch
  User mjaehn
  IdentityFile ~/.ssh/id_ed25519_iac
  ProxyCommand ssh -q -W %h:%p fog
  ForwardX11 yes
  ForwardX11Trusted yes

Host l_co2
  HostName co2.ethz.ch
  User l_c2sm
  IdentityFile ~/.ssh/id_ed25519_l_c2sm
  ProxyCommand ssh -q -W %h:%p fog2
  ForwardX11 yes
  ForwardX11Trusted yes

Host l_iacdipl-7
  HostName iacdipl-7.ethz.ch
  User l_c2sm
  IdentityFile ~/.ssh/id_ed25519_l_c2sm
  ProxyCommand ssh -q -W %h:%p fog2
  ForwardX11 yes
  ForwardX11Trusted yes

Host ti_fog
  HostName fog.ethz.ch
  User ti16102
  IdentityFile ~/.ssh/id_ed25519_iac_ti
  IdentitiesOnly yes

Host ti_fog2
  HostName fog2.ethz.ch
  User ti16102
  IdentityFile ~/.ssh/id_ed25519_iac_ti
  IdentitiesOnly yes

Host ti_atmos
  HostName atmos.ethz.ch
  User ti16102
  IdentityFile ~/.ssh/id_ed25519_iac_ti
  IdentitiesOnly yes
  ProxyJump ti_fog2
  ForwardX11 yes
  ForwardX11Trusted yes

Host ti_co2
  HostName co2.ethz.ch
  User ti16102
  IdentityFile ~/.ssh/id_ed25519_iac_ti
  IdentitiesOnly yes
  ProxyJump ti_fog2
  ForwardX11 yes
  ForwardX11Trusted yes

Host ti_l_iacdipl-7
  HostName iacdipl-7.ethz.ch
  User l_c2sm
  IdentityFile ~/.ssh/id_ed25519_l_c2sm
  IdentitiesOnly yes
  ProxyJump ti_fog
  ForwardX11 yes
  ForwardX11Trusted yes

